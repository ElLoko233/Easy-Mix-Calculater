

ScreenManager:
    name: srn_mgr
    id: srn_mgr

    MDScreen:
        name: "HomePage"

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: "EM Calculator"
                right_action_items: [["help-circle-outline", lambda x: app.change_screen('HelpPage')], ["comment-question", lambda x: app.change_screen( "AboutPage")]]
                specific_text_color: app.blue
                elevation: 10

            MDTabs:
                id: tabs
                text_color_normal: app.blue
                text_color_active: app.red
                color_indicator: app.blue
                tab_bar_height: '30dp'
                tab_indicator_anim: True

    ResultsPage:
        name: 'RP'
        id: RP

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: RP.product
                left_action_items: [["arrow-bottom-left", lambda x: app.change_screen( app.previous_screen, 'right')]]
                specific_text_color: app.blue
                elevation: 2
                id: RP_toolbar

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: ['10dp', '35dp']
                    spacing: '25dp'

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        spacing: '10dp'
                        elevation: '0.5dp'

                        MDBoxLayout:
                            adaptive_height: True
                            padding: '10dp'
                            md_bg_color: app.theme_cls.primary_color

                            MDLabel:
                                text: 'You will need:'
                                size_hint_y: None
                                height: self.texture_size[1]
                                font_style: 'H6'
                                height: self.texture_size[1]
                                theme_text_color: "Custom"
                                text_color: app.blue

                        MDBoxLayout:
                            adaptive_height: True
                            orientation: 'vertical'
                            id: RP_ingDisplay
                            padding: '10dp'

                    AnchorLayout:
                        anchor_x: 'center'

                        MDRaisedButton:
                            elevation: '5dp'
                            text: 'Done'
                            text_color: app.yellow
                            md_bg_color: app.blue
                            on_release: app.change_screen('HomePage')

    IngredientCollectorScreen:
        name: 'ICS'
        id: ICS

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: ICS.product
                left_action_items: [["home", lambda x: app.change_screen( 'HomePage', 'right')]]
                right_action_items: [["help-circle-outline", lambda x: app.change_screen('HelpPage')]]
                specific_text_color: app.blue
                elevation: 2
                id: ICS_toolbar

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: ['10dp', '25dp']
                    spacing: '25dp'

                    MDBoxLayout:
                        id: ICS_ingDisplay
                        orientation: 'vertical'
                        adaptive_height: True
                        spacing: '15dp'
                        padding: '10dp'
                        pos_hint: {'center_y': 0.5, 'center_x': 0.5}

                    AnchorLayout:
                        anchor_x: 'center'

                        MDRaisedButton:
                            elevation: '5dp'
                            markup: True
                            text: '[b][size=18]calculate[/size][/b]'
                            md_bg_color: app.blue
                            text_color: app.theme_cls.primary_color
                            on_release: ICS.collect_user_input()

    ProductCollectorScreen:
        name: 'PCS'
        id: PCS

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: ICS.product
                left_action_items: [["home", lambda x: app.change_screen( 'HomePage', 'right')]]
                right_action_items: [["help-circle-outline", lambda x: app.change_screen('HelpPage')]]
                specific_text_color: app.blue
                elevation: 2
                id: PCS_toolbar

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: ['10dp', '25dp']
                    spacing: '25dp'

                    MDBoxLayout:
                        id: PCS_ingDisplay
                        orientation: 'vertical'
                        adaptive_height: True
                        spacing: '15dp'
                        padding: '10dp'
                        pos_hint: {'center_y': 0.5, 'center_x': 0.5}

                    AnchorLayout:
                        anchor_x: 'center'

                        MDRaisedButton:
                            elevation: '5dp'
                            markup: True
                            text: '[b][size=18]calculate[/size][/b]'
                            md_bg_color: app.blue
                            text_color: app.theme_cls.primary_color
                            on_release: PCS.collect_user_input()
    MDScreen:
        name: 'HelpPage'

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: "Help"
                left_action_items: [["arrow-bottom-left", lambda x: app.change_screen( app.previous_screen, 'right')]]
                specific_text_color: app.blue
                elevation: 10

            HelpPage:
                do_scroll_x: False
                do_scroll_y: True
                id: HelpPage

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: '20dp'
                    spacing: '20dp'

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "5dp"
                        elevation: '0.5dp'

                        MDBoxLayout:
                            id: image_box
                            adaptive_height: True

                            Image:
                                source: './folder.png'
                                size_hint: .3, None
                                height: image_box.height

                        MDBoxLayout:
                            id: text_box
                            orientation: 'vertical'
                            adaptive_height: True
                            spacing: '2dp'

                            MDLabel:
                                font_style: 'H5'
                                text: 'Title'
                                theme_text_color: "Secondary"
                                size_hint_y: None
                                height: self.texture_size[1]

                            MDSeparator:
                                height: "2dp"
                                color: app.blue

                            MDLabel:
                                text: 'Text'
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "5dp"
                        elevation: '0.5dp'

                        MDBoxLayout:
                            id: image_box
                            adaptive_height: True

                            Image:
                                source: './folder.png'
                                size_hint: .3, None
                                height: image_box.height

                        MDBoxLayout:
                            id: text_box
                            orientation: 'vertical'
                            adaptive_height: True
                            spacing: '2dp'

                            MDLabel:
                                font_style: 'H5'
                                text: 'Title'
                                theme_text_color: "Secondary"
                                size_hint_y: None
                                height: self.texture_size[1]

                            MDSeparator:
                                height: "2dp"
                                color: app.blue

                            MDLabel:
                                text: 'Text'
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "5dp"
                        elevation: '0.5dp'

                        MDBoxLayout:
                            id: image_box
                            adaptive_height: True

                            Image:
                                source: ''
                                size_hint: .3, None
                                height: image_box.height

                        MDBoxLayout:
                            id: text_box
                            orientation: 'vertical'
                            adaptive_height: True
                            spacing: '2dp'

                            MDLabel:
                                font_style: 'H5'
                                text: 'Title'
                                theme_text_color: "Secondary"
                                size_hint_y: None
                                height: self.texture_size[1]

                            MDSeparator:
                                height: "2dp"
                                color: app.blue

                            MDLabel:
                                text: 'Text'
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"





    MDScreen:
        name: 'AboutPage'

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: "About Us"
                left_action_items: [["arrow-bottom-left", lambda x: app.change_screen( app.previous_screen, 'right')]]
                specific_text_color: app.blue
                elevation: 10

            AboutUsPage:
                do_scroll_x: False
                do_scroll_y: True
                id: AboutUsPage

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: '20dp'
                    spacing: '20dp'

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        spacing: '10dp'
                        elevation: '0.5dp'


                        MDLabel:
                            font_style: 'H5'
                            text: 'EM Calculator'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: 'Version'
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                text: '0.0.1'
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: AboutUsPage.EM_text[0]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: AboutUsPage.EM_text[1]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"



                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        spacing: '10dp'
                        elevation: '0.5dp'


                        MDLabel:
                            font_style: 'H5'
                            text: 'SnowFlake'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Telephone"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Telephone"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Address"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Address"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Website"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Website"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Customer Care"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Customer Care"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "facebook"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["SocialMedia"]["facebook"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "youtube"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["SocialMedia"]["youtube"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "instagram"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["SocialMedia"]["instagram"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        spacing: '10dp'
                        elevation: '0.5dp'

                        MDLabel:
                            font_style: 'H5'
                            text: 'App Developer'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "account"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.App_Dev["profile"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "gmail"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.App_Dev["gmail"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "github"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.App_Dev["github"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)
<ProductCollectorWidget>:
    id: product_input_widget
    adaptive_height: True
    row_default_height: '50dp'
    cols_minimum: {0:10}
    cols: 2

    MDBoxLayout:
        size_hint_x: 0.15

        MDLabel:
            id: label_text
            text: root.product
            halign: 'left'
            valign: 'bottom'

    BoxLayout:
        size_hint_x: 0.4

        MDTextField:
            id: input_value
            on_text_validate: (lambda : root.input_error(0) if root.is_valid() else root.input_error(1))()
            input_filter: 'int'
            hint_text: 'Input ingredients'
            helper_text_mode: 'on_error'
            helper_text: "input value that's > 0 and is < 9999"
            required: True


<IngredientCollectorWidget>:
    id: product_input_widget
    adaptive_height: True
    row_default_height: '50dp'
    cols_minimum: {0:10}
    cols: 3

    MDBoxLayout:
        size_hint_x: 0.15

        MDLabel:
            id: label_text
            text: root.product
            halign: 'left'
            valign: 'bottom'

    BoxLayout:
        size_hint_x: 0.4

        MDTextField:
            id: input_value
            on_text_validate: (lambda : root.input_error(0) if root.is_valid() else root.input_error(1))()
            input_filter: 'int'
            hint_text: 'Input ingredients'
            helper_text_mode: 'on_error'
            helper_text: "input value that's > 0 and is < 9999"
            required: True

    BoxLayout:
        size_hint_x: 0.2

        MDDropDownItem:
            id: input_unit
            pos_hint: {'center_y': .62}
            text: root.unit
            on_release: root.unit_menu.open()


<ProductScreen>:

    ScrollView:
        do_scroll_y: True
        do_scroll_x: False

        MDBoxLayout:
            orientation: 'vertical'
            adaptive_height: True
            padding: '20dp'
            spacing: '20dp'

            MDCard:
                id: orgCard
                orientation: "vertical"
                size_hint: [0.9, None]
                height: self.minimum_height
                pos_hint: {"center_x": .5, "center_y": .5}
                spacing: '10dp'
                elevation: '0.5dp'

                MDBoxLayout:
                    adaptive_height: True
                    padding: '10dp'
                    md_bg_color: app.theme_cls.primary_color

                    MDLabel:
                        font_style: 'H5'
                        text: root.title
                        theme_text_color: "Custom"
                        text_color: app.blue
                        size_hint_y: None
                        height: self.texture_size[1]

                MDGridLayout:
                    id: orgGrid
                    on_adaptive_height: root.DisplayOrg()
                    cols: 2
                    adaptive_height: True
                    padding: '25dp'
                    spacing: '35dp'

            MDGridLayout:
                cols: 2
                rows: 1
                adaptive_height: True

                AnchorLayout:
                    MDRaisedButton:
                        elevation: '5dp'
                        text: '#ingredients'
                        text_color: app.yellow
                        md_bg_color: app.blue
                        on_release: root.ingredient_collector_Screen()

                AnchorLayout:
                    MDRaisedButton:
                        elevation: '5dp'
                        text: '#products'
                        text_color: app.yellow
                        md_bg_color: app.blue
                        on_release: root.product_collector_Screen()

<ResultWidget>:
    id: result_widget
    adaptive_height: True
    row_default_height: '50dp'
    cols_minimum: {0:10}
    cols: 3

    MDBoxLayout:
        size_hint_x: 0.25

        MDLabel:
            id: label_text
            text: root.ingredient_name
            halign: 'left'
            valign: 'bottom'

    BoxLayout:
        size_hint_x: 0.3

        MDLabel:
            text: root.ingredient_value
            halign: 'left'
            valign: 'bottom'


    BoxLayout:
        size_hint_x: 0.35

        MDDropDownItem:
            id: input_unit
            pos_hint: {'center_y': .62}
            text: root.unit
            on_release: root.unit_menu.open()

<ResultWidgetProduct>:
    id: result_widget_product
    adaptive_height: True
    row_default_height: '50dp'
    cols_minimum: {0:10}
    cols: 2
    spacing: '2dp'

    MDBoxLayout:
        size_hint_x: 0.62

        MDLabel:
            id: label_text
            text: root.ingredient_name
            halign: 'left'
            valign: 'bottom'

    BoxLayout:
        size_hint_x: 0.38

        MDLabel:
            text: root.ingredient_value
            halign: 'left'
            valign: 'bottom'