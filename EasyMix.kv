#:include force Product_Resources/ResultProduct.kv
#:include force Product_Resources/ProductScreen.kv
#:include force Product_Resources/Collector.kv

ScreenManager:
    name: srn_mgr
    id: srn_mgr

    MDScreen:
        md_bg_color: app.blue
        name: 'splash'

        Image:
            source: 'Snow Flake logo_168x118.png'
            size_hint: None, None
            size: self.texture_size
            pos_hint: {'center_x':.5, 'center_y':.7}


        CustomLabel:
            id: title
            name: 'title'
            markup: True
            text: '[ref=text]EasyMix Calculator[/ref]'
            halign: 'center'
            size_hint_y: None
            height: self.texture_size[1]
            font_style: 'H6'
            bold: True
            theme_text_color: 'Custom'
            text_color: [1, 1 , 1, 1]
            pos_hint: {'center_y':.5}

    MDScreen:
        name: "HomePage"

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:

                id: home_toolbar
                title: "EasyMix"
                right_action_items: [['flashlight-off' if app.theme_cls.theme_style == 'Dark' else 'flashlight', app.change_style], ["help-circle-outline", lambda x: app.change_screen('HelpPage')], ["comment-question", lambda x: app.change_screen( "AboutPage")]]
                specific_text_color: app.blue if self.theme_cls.theme_style == 'Light' else app.blue
                elevation: 10

            MDTabs:
                id: tabs
                text_color_normal: app.blue
                text_color_active: app.red
                color_indicator: app.blue
                tab_bar_height: '30dp'
                tab_indicator_anim: True
                on_tab_switch: app.current_tab(*args)

    ResultsPage:
        name: 'RP'
        id: RP

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: RP.product
                left_action_items: [["arrow-bottom-left", lambda x: app.change_screen( app.previous_screen, 'right')]]
                specific_text_color: app.blue if self.theme_cls.theme_style == 'Light' else app.blue
                elevation: 2
                id: RP_toolbar

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: ['10dp', '35dp']
                    spacing: '25dp'

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        spacing: '10dp'
                        elevation: '0.5dp'

                        MDBoxLayout:
                            adaptive_height: True
                            padding: '10dp'
                            md_bg_color: app.theme_cls.primary_color

                            MDLabel:
                                text: 'You will need:'
                                size_hint_y: None
                                height: self.texture_size[1]
                                font_style: 'H6'
                                height: self.texture_size[1]
                                theme_text_color: "Custom"
                                text_color: app.blue

                        MDBoxLayout:
                            adaptive_height: True
                            orientation: 'vertical'
                            id: RP_ingDisplay
                            padding: '10dp'

                    AnchorLayout:
                        anchor_x: 'center'

                        MDRaisedButton:
                            elevation: '10dp'
                            text: 'Done'
                            text_color: app.yellow
                            md_bg_color: app.blue
                            on_release: app.change_screen('HomePage')

    IngredientCollectorScreen:
        name: 'ICS'
        id: ICS

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: ICS.product
                left_action_items: [["home", lambda x: app.change_screen( 'HomePage', 'right')]]
                right_action_items: [["help-circle-outline", lambda x: app.change_screen('HelpPage')]]
                specific_text_color: app.blue if self.theme_cls.theme_style == 'Light' else app.blue
                elevation: 2
                id: ICS_toolbar

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: ['10dp', '25dp']
                    spacing: '25dp'

                    MDBoxLayout:
                        id: ICS_ingDisplay
                        orientation: 'vertical'
                        adaptive_height: True
                        spacing: '15dp'
                        padding: '10dp'
                        pos_hint: {'center_y': 0.5, 'center_x': 0.5}

                    AnchorLayout:
                        anchor_x: 'center'

                        MDRaisedButton:
                            elevation: '10dp'
                            markup: True
                            text: '[b][size=18]calculate[/size][/b]'
                            md_bg_color: app.blue
                            text_color: app.theme_cls.primary_color
                            on_release: ICS.collect_user_input()

    ProductCollectorScreen:
        name: 'PCS'
        id: PCS

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: ICS.product
                left_action_items: [["home", lambda x: app.change_screen( 'HomePage', 'right')]]
                right_action_items: [["help-circle-outline", lambda x: app.change_screen('HelpPage')]]
                specific_text_color: app.blue if self.theme_cls.theme_style == 'Light' else app.blue
                elevation: 2
                id: PCS_toolbar

            ScrollView:
                do_scroll_x: False
                do_scroll_y: True

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: ['10dp', '25dp']
                    spacing: '25dp'

                    MDBoxLayout:
                        id: PCS_ingDisplay
                        orientation: 'vertical'
                        adaptive_height: True
                        spacing: '15dp'
                        padding: '10dp'
                        pos_hint: {'center_y': 0.5, 'center_x': 0.5}

                    AnchorLayout:
                        anchor_x: 'center'

                        MDRaisedButton:
                            elevation: '10dp'
                            markup: True
                            text: '[b][size=18]calculate[/size][/b]'
                            md_bg_color: app.blue
                            text_color: app.theme_cls.primary_color
                            on_release: PCS.collect_user_input()
    MDScreen:
        name: 'HelpPage'

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: "Help"
                left_action_items: [["arrow-bottom-left", lambda x: app.change_screen( app.previous_screen, 'right')]]
                specific_text_color: app.blue if self.theme_cls.theme_style == 'Light' else app.blue
                elevation: 10

            HelpPage:
                do_scroll_x: False
                do_scroll_y: True
                id: HelpPage

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: '20dp'
                    spacing: '30dp'

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "10dp"
                        spacing: '20dp'
                        elevation: '0.5dp'

                        MDBoxLayout:
                            adaptive_height: True
                            orientation: 'vertical'
                            spacing: '5dp'

                            MDLabel:
                                markup: True
                                text: '[size=20dp][color=#333333]Ingredient button[/color][/size]' if app.theme_cls.theme_style == 'Light' else '[size=20dp][color=#e6e6e6]Ingredient button[/color][/size]'
                                size_hint_y: None
                                height: self.texture_size[1]


                            MDSeparator:
                                height: "2dp"
                                color: app.blue

                        MDBoxLayout:
                            adaptive_height: True
                            padding: '20dp'

                            AnchorLayout:
                                anchor_x: 'center'
                                padding: '10dp'

                                MDRaisedButton:
                                    elevation: '10dp'
                                    text: '#ingredients'
                                    text_color: app.yellow
                                    md_bg_color: app.blue

                        MDLabel:
                            markup: True
                            text: HelpPage.ingredient_btn_help_p1
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            markup: True
                            text: HelpPage.ingredient_btn_help_p2
                            size_hint_y: None
                            bold: True
                            height: self.texture_size[1]

                        MDLabel:
                            markup: True
                            text: HelpPage.ingredient_btn_help_p3
                            size_hint_y: None
                            height: self.texture_size[1]

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "10dp"
                        spacing: '20dp'
                        elevation: '0.5dp'

                        MDBoxLayout:
                            adaptive_height: True
                            orientation: 'vertical'
                            spacing: '5dp'

                            MDLabel:
                                markup: True
                                text: '[size=20dp][color=#333333]Product button[/color][/size]' if app.theme_cls.theme_style == 'Light' else '[size=20dp][color=#e6e6e6]Product button[/color][/size]'
                                size_hint_y: None
                                height: self.texture_size[1]


                            MDSeparator:
                                height: "2dp"
                                color: app.blue

                        MDBoxLayout:
                            adaptive_height: True
                            padding: '20dp'

                            AnchorLayout:
                                anchor_x: 'center'
                                padding: '10dp'

                                MDRaisedButton:
                                    elevation: '10dp'
                                    text: '#products'
                                    text_color: app.yellow
                                    md_bg_color: app.blue

                        MDLabel:
                            markup: True
                            text: HelpPage.product_btn_help_p1
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDLabel:
                            markup: True
                            text: HelpPage.product_btn_help_p2
                            size_hint_y: None
                            bold: True
                            height: self.texture_size[1]

                        MDLabel:
                            markup: True
                            text: HelpPage.product_btn_help_p3
                            size_hint_y: None
                            height: self.texture_size[1]

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "10dp"
                        spacing: '20dp'
                        elevation: '0.5dp'

                        MDBoxLayout:
                            adaptive_height: True
                            orientation: 'vertical'
                            spacing: '5dp'

                            MDLabel:
                                markup: True
                                text: '[size=20dp][color=#333333]Ingredient input value[/color][/size]' if app.theme_cls.theme_style == 'Light' else '[size=20dp][color=#e6e6e6]Ingredient input value[/color][/size]'
                                size_hint_y: None
                                height: self.texture_size[1]


                            MDSeparator:
                                height: "2dp"
                                color: app.blue

                        MDTextField:
                            hint_text: 'Input ingredient'
                            focus: True
                            text: '500'


                        MDLabel:
                            markup: True
                            text: HelpPage.input_help_p1
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDTextField:
                            hint_text: 'Input ingredient'
                            focus: True
                            error: True
                            helper_text_mode: 'on_error'
                            helper_text: "input value that's > 0 and is < 9999"

                        MDLabel:
                            markup: True
                            text: HelpPage.input_help_error
                            size_hint_y: None
                            height: self.texture_size[1]


                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "10dp"
                        spacing: '20dp'
                        elevation: '0.5dp'

                        MDBoxLayout:
                            adaptive_height: True
                            orientation: 'vertical'
                            spacing: '5dp'

                            MDLabel:
                                markup: True
                                text: '[size=20dp][color=#333333]Ingredient unit[/color][/size]' if app.theme_cls.theme_style == 'Light' else '[size=20dp][color=#e6e6e6]Ingredient unit[/color][/size]'
                                size_hint_y: None
                                height: self.texture_size[1]


                            MDSeparator:
                                height: "2dp"
                                color: app.blue

                        MDBoxLayout:
                            adaptive_height: True
                            padding: '10dp'

                            AnchorLayout:
                                anchor_x: 'center'

                                MDDropDownItem:
                                    text: 'ml'

                        MDLabel:
                            markup: True
                            text: HelpPage.dropdown_help_p1
                            size_hint_y: None
                            height: self.texture_size[1]



    MDScreen:
        name: 'AboutPage'

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: "About Us"
                left_action_items: [["arrow-bottom-left", lambda x: app.change_screen( app.previous_screen, 'right')]]
                specific_text_color: app.blue if self.theme_cls.theme_style == 'Light' else app.blue
                elevation: 10

            AboutUsPage:
                do_scroll_x: False
                do_scroll_y: True
                id: AboutUsPage

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: '20dp'
                    spacing: '20dp'

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        spacing: '10dp'
                        elevation: '0.5dp'


                        MDLabel:
                            font_style: 'H5'
                            text: 'EM Calculator'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: 'Version'
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                text: '0.0.1'
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: AboutUsPage.EM_text[0]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: AboutUsPage.EM_text[1]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"



                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        spacing: '10dp'
                        elevation: '0.5dp'


                        MDLabel:
                            font_style: 'H5'
                            text: 'SnowFlake'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Telephone"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Telephone"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Address"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Address"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Website"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Website"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Customer Care"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Customer Care"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "facebook"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["SocialMedia"]["facebook"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "youtube"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["SocialMedia"]["youtube"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "instagram"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["SocialMedia"]["instagram"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        spacing: '10dp'
                        elevation: '0.5dp'

                        MDLabel:
                            font_style: 'H5'
                            text: 'App Developer'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "account"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.App_Dev["profile"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "gmail"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.App_Dev["gmail"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "github"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.App_Dev["github"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)
