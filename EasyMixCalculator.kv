
ScreenManager:
    name: srn_mgr
    id: srn_mgr

    MDScreen:
        name: "HomePage"

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: "EM Calculator"
                right_action_items: [["help-circle-outline", lambda x: app.change_screen(srn_mgr, 'HelpPage')], ["comment-question", lambda x: app.change_screen(srn_mgr, "AboutPage")]]
                specific_text_color: app.blue
                elevation: 10

            MDTabs:
                id: tabs
                text_color_normal: app.blue
                text_color_active: app.red
                color_indicator: app.blue
                tab_bar_height: '30dp'
                tab_indicator_anim: True

    MDScreen:
        name: 'HelpPage'

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: "Help"
                left_action_items: [["arrow-bottom-left", lambda x: app.change_screen(srn_mgr, 'HomePage', 'right')]]
                specific_text_color: app.blue
                elevation: 10

            HelpPage:
                do_scroll_x: False
                do_scroll_y: True
                id: HelpPage

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: '20dp'
                    spacing: '20dp'

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "5dp"
                        elevation: '0.5dp'

                        MDBoxLayout:
                            id: image_box
                            adaptive_height: True

                            Image:
                                source: './folder.png'
                                size_hint: .3, None
                                height: image_box.height

                        MDBoxLayout:
                            id: text_box
                            orientation: 'vertical'
                            adaptive_height: True
                            spacing: '2dp'

                            MDLabel:
                                font_style: 'H5'
                                text: 'Title'
                                theme_text_color: "Secondary"
                                size_hint_y: None
                                height: self.texture_size[1]

                            MDSeparator:
                                height: "2dp"
                                color: app.blue

                            MDLabel:
                                text: 'Text'
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "5dp"
                        elevation: '0.5dp'

                        MDBoxLayout:
                            id: image_box
                            adaptive_height: True

                            Image:
                                source: './folder.png'
                                size_hint: .3, None
                                height: image_box.height

                        MDBoxLayout:
                            id: text_box
                            orientation: 'vertical'
                            adaptive_height: True
                            spacing: '2dp'

                            MDLabel:
                                font_style: 'H5'
                                text: 'Title'
                                theme_text_color: "Secondary"
                                size_hint_y: None
                                height: self.texture_size[1]

                            MDSeparator:
                                height: "2dp"
                                color: app.blue

                            MDLabel:
                                text: 'Text'
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "5dp"
                        elevation: '0.5dp'

                        MDBoxLayout:
                            id: image_box
                            adaptive_height: True

                            Image:
                                source: ''
                                size_hint: .3, None
                                height: image_box.height

                        MDBoxLayout:
                            id: text_box
                            orientation: 'vertical'
                            adaptive_height: True
                            spacing: '2dp'

                            MDLabel:
                                font_style: 'H5'
                                text: 'Title'
                                theme_text_color: "Secondary"
                                size_hint_y: None
                                height: self.texture_size[1]

                            MDSeparator:
                                height: "2dp"
                                color: app.blue

                            MDLabel:
                                text: 'Text'
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"





    MDScreen:
        name: 'AboutPage'

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: "About Us"
                left_action_items: [["arrow-bottom-left", lambda x: app.change_screen(srn_mgr, 'HomePage', 'right')]]
                specific_text_color: app.blue
                elevation: 10

            AboutUsPage:
                do_scroll_x: False
                do_scroll_y: True
                id: AboutUsPage

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: '20dp'
                    spacing: '20dp'

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        spacing: '10dp'
                        elevation: '0.5dp'


                        MDLabel:
                            font_style: 'H5'
                            text: 'EM Calculator'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: 'Version'
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                text: '0.0.1'
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: AboutUsPage.EM_text[0]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: AboutUsPage.EM_text[1]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"



                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        spacing: '10dp'
                        elevation: '0.5dp'


                        MDLabel:
                            font_style: 'H5'
                            text: 'SnowFlake'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Telephone"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Telephone"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Address"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Address"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Website"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Website"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Customer Care"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["Customer Care"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "facebook"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["SocialMedia"]["facebook"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "youtube"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["SocialMedia"]["youtube"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "instagram"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.SnowFlake["SocialMedia"]["instagram"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        spacing: '10dp'
                        elevation: '0.5dp'

                        MDLabel:
                            font_style: 'H5'
                            text: 'App Developer'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "account"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.App_Dev["profile"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "gmail"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.App_Dev["gmail"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

                        MDGridLayout:
                            orientation: 'vertical'
                            cols: 2
                            rows: 1
                            spacing: '10dp'
                            adaptive_height: True

                            MDIcon:
                                icon: "github"
                                size_hint: [None, None]
                                width: self.texture_size[0]
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                markup: True
                                text: AboutUsPage.App_Dev["github"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_ref_press: AboutUsPage.RefHandler(self)

<IngredientCollectorScreen>:

    ScrollView:
        do_scroll_y: True
        do_scroll_x: False

        MDBoxLayout:
            orientation: 'vertical'
            adaptive_height: True
            padding: '20dp'
            spacing: '20dp'

<ProductScreen>:

    ScrollView:
        do_scroll_y: True
        do_scroll_x: False

        MDBoxLayout:
            orientation: 'vertical'
            adaptive_height: True
            padding: '20dp'
            spacing: '20dp'

            MDCard:
                id: orgCard
                orientation: "vertical"
                size_hint: [0.9, None]
                height: self.minimum_height
                pos_hint: {"center_x": .5, "center_y": .5}
                spacing: '10dp'
                elevation: '0.5dp'
                md_bg_color: app.grey

                MDBoxLayout:
                    adaptive_height: True
                    padding: '10dp'
                    md_bg_color: app.theme_cls.primary_color

                    MDLabel:
                        font_style: 'H5'
                        text: root.title
                        theme_text_color: "Custom"
                        text_color: app.blue
                        size_hint_y: None
                        height: self.texture_size[1]

                MDGridLayout:
                    id: orgGrid
                    on_adaptive_height: root.DisplayOrg()
                    cols: 2
                    adaptive_height: True
                    padding: '25dp'
                    spacing: '35dp'

            MDGridLayout:
                cols: 2
                rows: 1
                adaptive_height: True

                AnchorLayout:
                    MDFlatButton:
                        text: '#Ingredients'
                        text_color: app.yellow
                        md_bg_color: app.blue
                        on_release: root.ingredient_collector_Screen(app.root)

                AnchorLayout:
                    MDFlatButton:
                        text: '#Products'
                        text_color: app.yellow
                        md_bg_color: app.blue
                        on_release: root.product_collector_Screen(app.root)
