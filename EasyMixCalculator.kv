
ScreenManager:
    name: srn_mgr
    id: srn_mgr

    MDScreen:
        name: "HomePage"

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: "EM Calculator"
                right_action_items: [["help-circle-outline", lambda x: app.change_screen(srn_mgr, 'HelpPage')], ["comment-question", lambda x: app.change_screen(srn_mgr, "AboutPage")]]
                md_bg_color: app.yellow
                specific_text_color: app.blue
                elevation: 10

            MDBottomNavigation:
                text_color_normal: app.blue
                text_color_active: app.red
                panel_color: app.yellow

                MDBottomNavigationItem
                    name: 'MuffinScreen'
                    text: 'Muffin'
                    icon: 'muffin'

    MDScreen:
        name: 'HelpPage'

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: "Help"
                left_action_items: [["arrow-bottom-left", lambda x: app.change_screen(srn_mgr, 'HomePage', 'right')]]
                md_bg_color: app.yellow
                specific_text_color: app.blue
                elevation: 10

            BoxLayout:
                orientation: 'vertical'

    MDScreen:
        name: 'AboutPage'

        BoxLayout:
            orientation: 'vertical'

            MDToolbar:
                title: "About Us"
                left_action_items: [["arrow-bottom-left", lambda x: app.change_screen(srn_mgr, 'HomePage', 'right')]]
                md_bg_color: app.yellow
                specific_text_color: app.blue
                elevation: 10

            AboutUsPage:
                do_scroll_x: False
                do_scroll_y: True
                id: AboutUsPage

                MDBoxLayout:
                    orientation: 'vertical'
                    adaptive_height: True
                    padding: '20dp'
                    spacing: '20dp'

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        spacing: '10dp'
                        elevation: '1dp'


                        MDLabel:
                            font_style: 'H5'
                            text: 'EM Calculator'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: 'Version'
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                text: '0.0.1'
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: AboutUsPage.EM_text[0]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: AboutUsPage.EM_text[1]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"



                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        height: self.minimum_height
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        spacing: '10dp'
                        elevation: '1dp'


                        MDLabel:
                            font_style: 'H5'
                            text: 'SnowFlake'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Telephone"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                text: AboutUsPage.SnowFlake["Telephone"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Address"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                            MDLabel:
                                text: AboutUsPage.SnowFlake["Address"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"

                        MDBoxLayout:
                            orientation: 'vertical'
                            adaptive_height: True

                            MDLabel:
                                text: "Customer Care Email"
                                font_style: 'Caption'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Hint"
                                on_touch_down: None
                            MDLabel:
                                text: AboutUsPage.SnowFlake["Customer Care Email"]
                                font_style: 'Body1'
                                size_hint_y: None
                                height: self.texture_size[1]
                                theme_text_color: "Primary"
                                on_touch_down: AboutUsPage.open_browser(self)

                    MDCard:
                        orientation: "vertical"
                        size_hint: [0.9, None]
                        pos_hint: {"center_x": .5, "center_y": .5}
                        padding: "8dp"
                        elevation: '1dp'

                        MDLabel:
                            font_style: 'H5'
                            text: 'Developer'
                            theme_text_color: "Secondary"
                            size_hint_y: None
                            height: self.texture_size[1]

                        MDSeparator:
                            height: "2dp"
                            color: app.blue

                        MDLabel:
                            text: 'I can Dance, I can Dance, I can Dance,'