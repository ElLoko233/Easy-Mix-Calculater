<ProductScreen>:

    ScrollView:
        do_scroll_y: True
        do_scroll_x: False

        MDBoxLayout:
            orientation: 'vertical'
            adaptive_height: True
            padding: '20dp'
            spacing: '20dp'

            MDCard:
                id: orgCard
                orientation: "vertical"
                size_hint: [0.9, None]
                height: self.minimum_height
                pos_hint: {"right": 0}
                spacing: '10dp'
                elevation: '0.5dp'

                MDBoxLayout:
                    adaptive_height: True
                    padding: '10dp'
                    md_bg_color: app.theme_cls.primary_color

                    MDLabel:
                        font_style: 'H5'
                        text: root.title
                        theme_text_color: "Custom"
                        text_color: app.blue
                        size_hint_y: None
                        height: self.texture_size[1]

                MDGridLayout:
                    id: orgGrid
                    cols: 1
                    adaptive_height: True
                    padding: '25dp'
                    spacing: '35dp'

            MDGridLayout:
                cols: 2
                rows: 1
                adaptive_height: True

                AnchorLayout:
                    MDRaisedButton:
                        elevation: '10dp'
                        text: '#ingredients'
                        text_color: app.yellow
                        md_bg_color: app.blue
                        on_release: root.ingredient_collector_Screen()

                AnchorLayout:
                    MDRaisedButton:
                        elevation: '10dp'
                        text: '#products'
                        text_color: app.yellow
                        md_bg_color: app.blue
                        on_release: root.product_collector_Screen()